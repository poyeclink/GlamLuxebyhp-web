// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  cliente
  administrador
}

enum AddressType {
  casa
  apartamento
}

enum PricingTier {
  individual
  mayorista
}

enum OrderStatus {
  reservado
  confirmado
  enviado
  cancelado
  vencido
}

enum PaymentMethod {
  tarjeta
  zelle
  cashapp
  paypal
}

enum InventoryLogReason {
  reserva
  venta
  liberacion
  ajuste_manual
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  email         String         @unique
  passwordHash  String
  role          UserRole
  whatsapp      String?
  createdAt     DateTime       @default(now())
  addresses     Address[]
  cart          Cart?
  orders        Order[]
  inventoryLogs InventoryLog[]
}

model Address {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String?     @db.Uuid
  user        User?       @relation(fields: [userId], references: [id])
  fullName    String
  whatsapp    String
  email       String
  addressLine String
  addressType AddressType
  city        String
  state       String
  zip         String
  notes       String?
  createdAt   DateTime    @default(now())

  @@index([userId])
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id              String           @id @default(uuid()) @db.Uuid
  slug            String           @unique
  name            String
  categoryId      String           @db.Uuid
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description     String           @db.Text
  wholesalePrice  Decimal          @db.Decimal(10, 2)
  individualPrice Decimal          @db.Decimal(10, 2)
  boxed           Boolean          @default(false)
  hasVariants     Boolean          @default(false)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  variants        ProductVariant[]
  images          ProductImage[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String  @unique
  alt       String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([productId])
}

model ProductVariant {
  id            String         @id @default(uuid()) @db.Uuid
  productId     String         @db.Uuid
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  size          String
  stock         Int            @default(0)
  cartItems     CartItem[]
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]

  @@unique([productId, size])
}

model Cart {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String?    @unique @db.Uuid
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Carrito de invitado (sin cuenta): identificado por una cookie opaca en vez
  // de un usuario — ver src/lib/cart-session.ts. Se fusiona con el carrito del
  // User y se borra al iniciar sesión/registrarse (mergeGuestCartIntoUser).
  //
  // La migración guest_cart_session_token agrega además un CHECK de Postgres
  // (userId xor sessionToken) que este schema no puede expresar — invisible
  // para `prisma db push`, que no reproduce SQL fuera de las migraciones. No
  // usar `db push` contra esta tabla; el flujo de este proyecto ya es
  // migrate dev/deploy (ver CLAUDE.md).
  sessionToken String?    @unique
  items        CartItem[]
}

model CartItem {
  id        String          @id @default(uuid()) @db.Uuid
  cartId    String          @db.Uuid
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String          @db.Uuid
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?         @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime        @default(now())

  // Postgres no deduplica NULLs en un índice único, así que esto solo protege
  // contra filas duplicadas cuando variantId no es null (productos con tallas,
  // donde el stock limitado sí importa) — ver addToCart en cart-service.ts.
  @@unique([cartId, productId, variantId])
  @@index([productId])
}

model ShippingRate {
  id          String      @id @default(uuid()) @db.Uuid
  tier        PricingTier
  minQuantity Int
  maxQuantity Int?
  price       Decimal     @db.Decimal(10, 2)

  @@unique([tier, minQuantity])
}

model Order {
  id     String      @id @default(uuid()) @db.Uuid
  // Opcional igual que Address.userId: pensado para checkout de invitado a
  // futuro (el carrito ya lo admite desde el ticket #22), no explotado todavía.
  userId String?     @db.Uuid
  user   User?       @relation(fields: [userId], references: [id])
  status OrderStatus @default(reservado)

  // Tier de precio aplicado a TODAS las líneas al momento de comprar
  // (cart-service.ts calcula esto en vivo; aquí se congela porque un pedido
  // ya confirmado no debe cambiar si después cambia el umbral mayorista).
  pricingTier   PricingTier
  paymentMethod PaymentMethod

  // Igual que pricingTier: montos fijados al confirmar el pedido, no
  // recalculados — no deben moverse si después cambian ShippingRate o los
  // precios de los productos. shippingCost es null en el tier mayorista
  // ("se coordina aparte", igual que shippingEstimate en el carrito); total
  // en ese caso se guarda igual a subtotal (el envío se factura aparte, no
  // se asume $0 ni se deja total en null).
  subtotal     Decimal  @db.Decimal(10, 2)
  shippingCost Decimal? @db.Decimal(10, 2)
  total        Decimal  @db.Decimal(10, 2)

  // Snapshot de la dirección de envío (ticket #24 copia estos campos desde el
  // Address elegido), no una relación — un pedido ya creado no debe cambiar
  // si el cliente edita o borra esa dirección guardada después. Sin FK de
  // referencia tipo OrderItem.productId a propósito: a diferencia de un
  // Product (que un admin borra deliberadamente y rara vez), el punto mismo
  // de snapshottear es que nadie deba "ver la versión actual" de la
  // dirección de un pedido ya hecho.
  fullName    String
  whatsapp    String
  email       String
  addressLine String
  addressType AddressType
  city        String
  state       String
  zip         String

  termsAcceptedAt DateTime
  // 3 días desde la creación (regla de negocio) — el cron del ticket #28
  // marca `vencido` los pedidos `reservado` que pasan este momento sin pago.
  reservedUntil   DateTime
  createdAt       DateTime       @default(now())
  items           OrderItem[]
  inventoryLogs   InventoryLog[]

  @@index([userId])
  // (status, reservedUntil) en vez de solo status: sirve directo la consulta
  // del cron #28 (status = reservado AND reservedUntil < now()).
  @@index([status, reservedUntil])
}

model OrderItem {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // FK opcional solo de referencia/admin — la fuente de verdad para mostrar
  // o facturar un pedido ya hecho es el snapshot de abajo, no el Product
  // actual (que puede cambiar de precio, desactivarse o borrarse después).
  productId String?  @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Igual de opcional/solo-referencia que productId de arriba, pero con un
  // propósito operativo real (no solo mostrar en el admin): el ticket #28
  // (cron de expiración) necesita saber exactamente qué ProductVariant
  // devolver al stock cuando un pedido reservado vence sin pago. variantSize
  // (el snapshot de abajo) no alcanza para eso — reconstruir el id buscando
  // por productId+size sería frágil si el admin renombra o recrea la talla.
  variantId String?         @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName String
  variantSize String?
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model InventoryLog {
  id String @id @default(uuid()) @db.Uuid

  // Opcional + SetNull (no Cascade): igual que OrderItem.variantId, este log
  // es un registro de auditoría que debe sobrevivir a que el admin borre esa
  // talla o el producto más adelante (product-variant-service.ts / cascade
  // desde deleteProduct) — un Cascade aquí destruiría en silencio el
  // historial que este modelo existe para preservar.
  variantId String?            @db.Uuid
  variant   ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  reason    InventoryLogReason

  // Positivo = entra stock (liberación, ajuste manual +), negativo = sale
  // (reserva, ajuste manual -). "venta" (reservado -> confirmado) queda
  // reservado para cuando exista un evento de stock real y distinto de la
  // reserva que justifique una fila propia — hoy el admin de pedidos no
  // escribe ninguna, porque el stock ya se descontó en la reserva y una fila
  // en 0 no es un movimiento real (ver updateOrderStatus).
  quantityChange Int
  // Snapshot del stock del variant justo después de este movimiento — permite
  // reconstruir el historial sin recalcular sumando deltas.
  stockAfter     Int

  // Solo se llena para reserva/venta/liberación (movimientos disparados por
  // un pedido); null en ajuste_manual.
  orderId String? @db.Uuid
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Solo se llena en ajuste_manual (quién hizo la corrección) — null en
  // movimientos automáticos (checkout, cron de expiración).
  createdBy String? @db.Uuid
  admin     User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  note      String?
  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
  @@index([orderId])
}
