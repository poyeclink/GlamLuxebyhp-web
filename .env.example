# Conexión pooled (Supavisor/PgBouncer) — la usa la app en runtime (src/lib/prisma.ts), serverless-friendly.
# Formato Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=""

# Conexión directa — la usa el CLI de Prisma (migrate/db push/studio) vía prisma7.config.ts.
# Usar el Session pooler (puerto 5432, mismo host que el pooler de arriba) en vez de db.[project-ref].supabase.co:
# ese host de conexión directa real solo resuelve por IPv6 y muchas redes no tienen salida IPv6 (ETIMEDOUT).
# Formato: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL=""

# Secreto para firmar las cookies de sesión (JWT). Generar uno distinto por entorno,
# por ejemplo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
SESSION_COOKIE_NAME="glamluxe_session"

# Cuenta de administrador inicial — la crea/actualiza `pnpm db:seed` (upsert, idempotente).
# No hay auto-registro de admins (por diseño, según el PDF de análisis).
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Admin para el equipo de desarrollo (también lo crea `pnpm db:seed`).
DEV_ADMIN_NAME=""
DEV_ADMIN_EMAIL=""
DEV_ADMIN_PASSWORD=""

# Opcional: cliente de prueba que crea `pnpm db:seed` (solo desarrollo).
DEMO_CUSTOMER_EMAIL=""
DEMO_CUSTOMER_PASSWORD=""

# URL pública del sitio, sin slash final (canonical, sitemap, Open Graph). Ej. https://glamluxebyhj.com
NEXT_PUBLIC_SITE_URL=""

# Correo de contacto público (página /contacto). Opcional: vacío = no se muestra.
NEXT_PUBLIC_CONTACT_EMAIL=""

# Número de WhatsApp de contacto del negocio, formato internacional sin "+" ni espacios (ej. 18095551234).
# Opcional: si se deja vacío, el enlace de WhatsApp simplemente no se muestra en el footer.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Redes sociales del footer — mismo patrón que WhatsApp: opcionales, si se
# dejan vacías ese botón simplemente no se renderiza.
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_TIKTOK_URL=""

# Autoriza al Vercel Cron (src/app/api/cron/expire-orders) a llamar ese endpoint:
# Vercel manda "Authorization: Bearer <CRON_SECRET>" automáticamente en producción.
# Generar uno distinto por entorno, igual que AUTH_SECRET.
CRON_SECRET=""

# Stripe (pago con tarjeta vía Stripe Checkout). Sin STRIPE_SECRET_KEY el
# checkout no ofrece "Tarjeta". sk_test_... en desarrollo, sk_live_... en producción.
# STRIPE_WEBHOOK_SECRET (whsec_...) es el "Signing secret" del endpoint
# <SITE_URL>/api/stripe/webhook en Stripe → Developers → Webhooks
# (eventos: checkout.session.completed, checkout.session.async_payment_succeeded y
# checkout.session.expired). En local lo imprime:
# stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.expired --forward-to localhost:3000/api/stripe/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Cloudflare R2 (almacenamiento de imágenes de producto). Ver panel de Cloudflare > R2.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Dominio público desde el que se sirven los objetos del bucket (custom domain o el *.r2.dev), sin slash final.
R2_PUBLIC_URL=""

# Cloudflare Workers AI (traducción es->en, ver src/lib/cloudflare-ai.ts) — reusa R2_ACCOUNT_ID
# de arriba (misma cuenta de Cloudflare). Token con permiso "Workers AI" a nivel de cuenta,
# creado en el dashboard de Cloudflare > My Profile > API Tokens (distinto de las llaves de R2,
# que son credenciales S3, no un API token de Cloudflare).
CLOUDFLARE_API_TOKEN=""

# Correo transaccional (SMTP, src/lib/mailer.ts): recuperación y cambio de contraseña,
# bienvenida, estado de pedidos, y avisos al admin (pedido nuevo, cliente nuevo, mensaje de
# Contacto, stock bajo). Vacío = no se envía nada y el formulario de Contacto vuelve a abrir
# WhatsApp/correo. Gmail: SMTP_USER es la cuenta y SMTP_PASSWORD una contraseña de aplicación
# (Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones),
# nunca la contraseña normal. Los espacios de la contraseña de aplicación se ignoran.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
# Opcional. Remitente visible; por defecto "Glam Luxe by HJ" <SMTP_USER>. Gmail solo respeta
# otra dirección si está agregada como alias ("Enviar como") en esa cuenta.
MAIL_FROM=""
# Opcional. Bandeja que recibe los avisos del admin; por defecto SMTP_USER.
ADMIN_NOTIFY_EMAIL=""
